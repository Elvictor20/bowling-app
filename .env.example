# Copia este fichero a .env y ajusta los valores.

# Clave con la que se firman los JWT. Genera una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave

# Cadena de conexión SQLAlchemy (SQLite por defecto, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/bowling.db

# SMTP (opcional). Si se deja vacío, los correos se imprimen por consola.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_NAME=Bowling Club App

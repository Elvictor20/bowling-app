# Copia este fichero a .env y ajusta los valores.

# Clave con la que se firman los JWT. Genera una propia:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave

# Dirección pública de la web: se usa en los enlaces de los correos
APP_URL=https://bolosmanager.com

# Cadena de conexión SQLAlchemy (SQLite por defecto, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/bowling.db

# --- Correo (recuperación de contraseña y bienvenida) ---
# Sin SMTP_HOST el envío está desactivado y la web avisa de que no puede mandar enlaces.
# Para desarrollo, EMAILS_CONSOLE=true imprime los correos en la consola del servidor.
SMTP_HOST=
# starttls (normalmente puerto 587), ssl (465) o none (25, p. ej. un Postfix local)
SMTP_SECURITY=starttls
# Si se deja vacío: 587 con starttls, 465 con ssl y 25 con none
SMTP_PORT=
# Opcionales: déjalos vacíos si el servidor de correo no pide autenticación
SMTP_USER=
SMTP_PASSWORD=
# Remitente de los correos (si se deja vacío se usa SMTP_USER)
EMAILS_FROM=no-responder@bolosmanager.com
EMAILS_FROM_NAME=Bowling Club App
EMAILS_CONSOLE=
